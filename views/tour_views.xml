<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tour_form" model="ir.ui.view">
        <field name="name">security.tour.form</field>
        <field name="model">security.tour</field>
        <field name="arch" type="xml">
            <form string="Security Tour">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,finished"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="template_id"/>
                            <field name="agent_id"/>
                            <field name="superviser_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Requirements">
                        <group>
                            <field name="require_selfie"/>
                            <field name="require_photo_place"/>
                        </group>
                        <group>
                            <field name="strict_ordering"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkpoints" name="checkpoints" invisible="not site_id">
                            <field name="checkpoint_ids" widget="section_and_note_one2many">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="checkpoint_id" domain="[('site_id', '=', parent.site_id)]"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Logs" name="logs">
                            <field name="log_ids">
                                <tree>
                                    <field name="time"/>
                                    <field name="checkpoint_id"/>
                                    <field name="status"/>
                                    
                                    <field name="require_selfie" column_invisible="1"/>
                                    <field name="require_photo_place" column_invisible="1"/>
                                    
                                    <field name="photo_selfie" required="require_selfie"/>
                                    <field name="photo_place" required="require_photo_place"/>
                                    
                                    <field name="comment"/>
                                    <button name="action_view_incidents" 
                                            type="object" 
                                            string="View/Add Incidents" 
                                            icon="fa-exclamation-triangle"
                                            class="btn-link"
                                            invisible="status != 'incident'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tour_tree" model="ir.ui.view">
        <field name="name">security.tour.tree</field>
        <field name="model">security.tour</field>
        <field name="arch" type="xml">
            <tree string="Security Tours">
                <field name="name"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="date"/>
                <field name="start_time" widget="float_time"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'planned'" decoration-success="state == 'finished'"/>
            </tree>
        </field>
    </record>

    <record id="view_tour_kanban" model="ir.ui.view">
        <field name="name">security.tour.kanban</field>
        <field name="model">security.tour</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_expand="_group_expand_states" class="o_kanban_small_column">
                <field name="name"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="date"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="state"/>
                <field name="template_id"/>
                <progressbar field="state" colors='{"draft": "muted", "planned": "info", "in_progress": "warning", "finished": "success"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <i class="fa fa-map-marker"/> <field name="site_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-calendar"/> <field name="date"/>
                                </div>
                                <div>
                                    <i class="fa fa-clock-o"/> 
                                    <field name="start_time" widget="float_time"/> - 
                                    <field name="end_time" widget="float_time"/>
                                </div>
                                <div t-if="record.agent_id.raw_value">
                                    <i class="fa fa-user"/> <field name="agent_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_security_tour" model="ir.actions.act_window">
        <field name="name">Tours</field>
        <field name="res_model">security.tour</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

</odoo>
