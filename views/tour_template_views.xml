<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_tour_template_kanban" model="ir.ui.view">
        <field name="name">security.tour.template.kanban</field>
        <field name="model">security.tour.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="site_id" class="o_kanban_dashboard">
                <field name="id"/>
                <field name="name"/>
                <field name="title"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="frequency"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="active"/>
                <field name="checkpoint_ids"/>
                <field name="tour_count"/>
                <progressbar field="frequency" colors='{"daily":"success","weekly":"warning","manual":"info"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click" t-attf-class="oe_kanban_card #{!record.active.raw_value ? 'oe_kanban_color_2' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="title"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="name"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="active" widget="boolean_toggle"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-map-marker text-primary me-2"/>
                                                <field name="site_id" class="fw-bold"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-user text-info me-2"/>
                                                <field name="agent_id"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-clock-o text-success me-2"/>
                                                <span>
                                                    <field name="start_time" widget="float_time"/> - 
                                                    <field name="end_time" widget="float_time"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-12">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-refresh text-warning me-2"/>
                                                <field name="frequency"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mt-3 pt-2 border-top">
                                        <div class="col-6">
                                            <div class="text-center">
                                                <div class="h4 mb-0">
                                                    <field name="checkpoint_ids" widget="statinfo" string=""/>
                                                </div>
                                                <small class="text-muted">
                                                    <i class="fa fa-map-pin me-1"/> Checkpoints
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-center">
                                                <div class="h4 mb-0">
                                                    <field name="tour_count"/>
                                                </div>
                                                <small class="text-muted">
                                                    <i class="fa fa-list me-1"/> Tours
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_security_tour_template_tree" model="ir.ui.view">
        <field name="name">security.tour.template.tree</field>
        <field name="model">security.tour.template</field>
        <field name="arch" type="xml">
            <tree string="Tour Templates">
                <field name="name"/>
                <field name="title"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="frequency"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_security_tour_template_form" model="ir.ui.view">
        <field name="name">security.tour.template.form</field>
        <field name="model">security.tour.template</field>
        <field name="arch" type="xml">
            <form string="Tour Template">
                <header>
                    <button name="action_generate_tour" string="Generate Tour" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <label for="title"/>
                        <h2>
                            <field name="title" placeholder="Morning Patrol..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="agent_id"/>
                            <field name="frequency"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Planning">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkpoints" name="checkpoints">
                            <div class="oe_button_box">
                                <button name="action_load_all_checkpoints" 
                                        string="Load All Checkpoints" 
                                        type="object" 
                                        class="btn-primary"
                                        icon="fa-download"
                                        help="Load all checkpoints from the selected site"/>
                            </div>
                            <field name="checkpoint_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="checkpoint_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Configuration" name="config">
                            <group>
                                <field name="grace_period"/>
                                <field name="strict_ordering"/>
                                <field name="require_selfie"/>
                                <field name="require_photo_place"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_tour_template" model="ir.actions.act_window">
        <field name="name">Tour Templates</field>
        <field name="res_model">security.tour.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tour template!
            </p>
            <p>
                Define your patrol routes and schedules here.
            </p>
        </field>
    </record>
</odoo>
