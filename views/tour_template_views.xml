<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_tour_template_tree" model="ir.ui.view">
        <field name="name">security.tour.template.tree</field>
        <field name="model">security.tour.template</field>
        <field name="arch" type="xml">
            <tree string="Tour Templates">
                <field name="name"/>
                <field name="title"/>
                <field name="site_id"/>
                <field name="agent_id"/>
                <field name="frequency"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_security_tour_template_form" model="ir.ui.view">
        <field name="name">security.tour.template.form</field>
        <field name="model">security.tour.template</field>
        <field name="arch" type="xml">
            <form string="Tour Template">
                <header>
                    <button name="action_generate_tour" string="Generate Tour" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <label for="title"/>
                        <h2>
                            <field name="title" placeholder="Morning Patrol..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="agent_id"/>
                            <field name="frequency"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Planning">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checkpoints" name="checkpoints">
                            <div class="oe_button_box">
                                <button name="action_load_all_checkpoints" 
                                        string="Load All Checkpoints" 
                                        type="object" 
                                        class="btn-primary"
                                        icon="fa-download"
                                        help="Load all checkpoints from the selected site"/>
                            </div>
                            <field name="checkpoint_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="checkpoint_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Configuration" name="config">
                            <group>
                                <field name="grace_period"/>
                                <field name="strict_ordering"/>
                                <field name="require_selfie"/>
                                <field name="require_photo_place"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_tour_template" model="ir.actions.act_window">
        <field name="name">Tour Templates</field>
        <field name="res_model">security.tour.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tour template!
            </p>
            <p>
                Define your patrol routes and schedules here.
            </p>
        </field>
    </record>
</odoo>
