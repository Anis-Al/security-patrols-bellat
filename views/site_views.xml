<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_site_tree" model="ir.ui.view">
        <field name="name">security.site.tree</field>
        <field name="model">security.site</field>
        <field name="arch" type="xml">
            <tree string="Sites">
                <field name="name"/>
                <field name="checkpoint_count"/>
                <!-- <field name="adresse"/> -->
            </tree>
        </field>
    </record>

    <record id="view_site_form" model="ir.ui.view">
        <field name="name">security.site.form</field>
        <field name="model">security.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Site Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="checkpoint_count"/>
                    </group>
                    <!-- <group>
                        <group>
                            <field name="adresse"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group> -->
                    <notebook>
                        <page string="Checkpoints">
                            <field name="checkpoint_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="check_type"/>
                                    <field name="identifier"/>
                                    <button name="action_open_record" type="object" icon="fa-external-link" title="Open Details"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_site_form" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">security.site</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
